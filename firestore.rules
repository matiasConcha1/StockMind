rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function currentUserDocExists() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function currentUserRole() {
      return currentUserDocExists()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : null;
    }

    function isActiveUser() {
      return isSignedIn()
        && (
          !currentUserDocExists()
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isActive != false
        );
    }

    function isAdmin() {
      return currentUserRole() == 'admin';
    }

    function isAdminOrOperator() {
      return !currentUserDocExists()
        || currentUserRole() in ['admin', 'operator', 'editor'];
    }

    function touchesDeleteFields() {
      return request.resource.data.diff(resource.data).changedKeys().hasAny([
        'isDeleted',
        'deletedAt',
        'deletedBy',
        'deleteReason',
      ]);
    }

    function ownerCanNormalizeRole() {
      return isSignedIn()
        && (
          !resource.data.keys().hasAny(['role'])
          || resource.data.role == null
          || (
            resource.data.role == 'editor'
            && request.resource.data.role == 'operator'
          )
        );
    }

    match /app_config/{docId} {
      allow read: if isActiveUser() && isAdminOrOperator();
      allow create, update: if isActiveUser() && isAdmin();
      allow delete: if false;
    }

    match /users/{userId} {
      allow read: if (isOwner(userId) && isActiveUser()) || isAdmin();

      allow create: if isOwner(userId)
        && request.resource.data.role in ['admin', 'operator'];

      allow update: if (
          isOwner(userId)
          && isActiveUser()
          && (
            !('role' in request.resource.data.diff(resource.data).changedKeys())
            || ownerCanNormalizeRole()
          )
        ) || isAdmin();

      allow delete: if false;

      match /products/{productId} {
        allow read, create: if isOwner(userId) && isActiveUser() && isAdminOrOperator();
        allow update: if isOwner(userId)
          && (
            (isActiveUser() && isAdminOrOperator() && !touchesDeleteFields())
            || isAdmin()
          );
        allow delete: if isOwner(userId) && isAdmin();
      }

      match /locations/{locationId} {
        allow read, create, update: if isOwner(userId) && isActiveUser() && isAdminOrOperator();
        allow delete: if isOwner(userId) && isAdmin();
      }

      match /location_types/{typeId} {
        allow read, create, update: if isOwner(userId) && isActiveUser() && isAdminOrOperator();
        allow delete: if isOwner(userId) && isAdmin();
      }

      match /alerts/{alertId} {
        allow read, create, update: if isOwner(userId) && isActiveUser() && isAdminOrOperator();
        allow delete: if false;
      }

      match /stock_movements/{movementId} {
        allow read, create, update: if isOwner(userId) && isActiveUser() && isAdminOrOperator();
        allow delete: if false;
      }

      match /stock_requests/{requestId} {
        allow read, create, update: if isOwner(userId) && isActiveUser() && isAdminOrOperator();
        allow delete: if false;
      }

      match /activity_logs/{logId} {
        allow create: if isOwner(userId) && isActiveUser() && isAdminOrOperator();
        allow read: if isOwner(userId) && isActiveUser() && isAdminOrOperator();
        allow update, delete: if false;
      }

      match /notification_tokens/{tokenId} {
        allow read: if (isOwner(userId) && isActiveUser()) || isAdmin();
        allow create, update: if isOwner(userId) && isActiveUser();
        allow delete: if isOwner(userId) || isAdmin();
      }
    }
  }
}

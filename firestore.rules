rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function userDoc(userId) {
      return get(/databases/$(database)/documents/users/$(userId));
    }

    function currentUserDocExists() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function currentUserRole() {
      return currentUserDocExists()
        ? userDoc(request.auth.uid).data.role
        : null;
    }

    function normalizedRole(role) {
      return role in ['admin', 'editor', 'operator', 'viewer']
        ? role
        : 'viewer';
    }

    function isActiveUser() {
      return isSignedIn()
        && (
          !currentUserDocExists()
          || userDoc(request.auth.uid).data.isActive != false
        );
    }

    function companyDoc(companyId) {
      return get(/databases/$(database)/documents/companies/$(companyId));
    }

    function companyMembershipDoc(companyId, userId) {
      return get(/databases/$(database)/documents/companies/$(companyId)/users/$(userId));
    }

    function companyDocAfter(companyId) {
      return getAfter(/databases/$(database)/documents/companies/$(companyId));
    }

    function companyMembershipDocAfter(companyId, userId) {
      return getAfter(/databases/$(database)/documents/companies/$(companyId)/users/$(userId));
    }

    function isCompanyMember(companyId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/companies/$(companyId)/users/$(request.auth.uid));
    }

    function companyRole(companyId) {
      return isCompanyMember(companyId)
        ? companyMembershipDoc(companyId, request.auth.uid).data.role
        : null;
    }

    function isCompanyActive(companyId) {
      return isCompanyMember(companyId)
        && companyMembershipDoc(companyId, request.auth.uid).data.isActive != false
        && companyMembershipDoc(companyId, request.auth.uid).data.status == 'accepted';
    }

    function canCompanyRead(companyId) {
      return isActiveUser() && isCompanyActive(companyId);
    }

    function canCompanyManageCatalog(companyId) {
      return canCompanyRead(companyId)
        && normalizedRole(companyRole(companyId)) in ['admin', 'editor'];
    }

    function canCompanyManageInventory(companyId) {
      return canCompanyRead(companyId)
        && normalizedRole(companyRole(companyId)) in ['admin', 'editor', 'operator'];
    }

    function canCompanyManageUsers(companyId) {
      return canCompanyRead(companyId)
        && normalizedRole(companyRole(companyId)) == 'admin';
    }

    function canCompanyManageProfile(companyId) {
      return canCompanyRead(companyId)
        && normalizedRole(companyRole(companyId)) in ['admin', 'editor'];
    }

    function isCompanyBootstrapOwner(companyId, userId) {
      return isOwner(userId)
        && existsAfter(/databases/$(database)/documents/companies/$(companyId))
        && companyDocAfter(companyId).data.ownerId == request.auth.uid
        && existsAfter(/databases/$(database)/documents/companies/$(companyId)/users/$(userId))
        && normalizedRole(companyMembershipDocAfter(companyId, userId).data.role) == 'admin'
        && companyMembershipDocAfter(companyId, userId).data.status == 'accepted';
    }

    function invitationBelongsToCurrentIdentity(data) {
      return isSignedIn()
        && (
          data.emailLower == ''
          || (data.inviteeUid != null && data.inviteeUid == request.auth.uid)
          || (request.auth.token.email != null && data.emailLower == request.auth.token.email)
        );
    }

    function invitationNotExpired(data) {
      return !('expiresAt' in data)
        || data.expiresAt == null
        || data.expiresAt > request.time;
    }

    function touchesDeleteFields() {
      return request.resource.data.diff(resource.data).changedKeys().hasAny([
        'isDeleted',
        'deletedAt',
        'deletedBy',
        'deleteReason',
      ]);
    }

    match /app_config/{docId} {
      allow read: if isActiveUser() && normalizedRole(currentUserRole()) == 'admin';
      allow create, update: if isActiveUser() && normalizedRole(currentUserRole()) == 'admin';
      allow delete: if false;
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || normalizedRole(currentUserRole()) == 'admin';

      allow create: if isOwner(userId)
        && normalizedRole(request.resource.data.role) in ['admin', 'editor', 'operator', 'viewer']
        && (!('accountType' in request.resource.data)
          || request.resource.data.accountType in ['business', 'person']);

      allow update: if (
          isOwner(userId)
          && isActiveUser()
          && (
            !('role' in request.resource.data.diff(resource.data).changedKeys())
            || request.resource.data.role == resource.data.role
          )
        ) || normalizedRole(currentUserRole()) == 'admin';

      allow delete: if false;

      match /{document=**} {
        allow read: if isOwner(userId) && isActiveUser();
        allow create, update: if isOwner(userId) && isActiveUser();
        allow delete: if false;
      }
    }

    match /companies/{companyId} {
      allow read: if canCompanyRead(companyId);
      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid;
      allow update: if canCompanyManageProfile(companyId);
      allow delete: if false;

      match /users/{userId} {
        allow read: if canCompanyRead(companyId);
        allow create: if (
            isOwner(userId)
            && (
              companyDoc(companyId).data.ownerId == request.auth.uid
              || isCompanyBootstrapOwner(companyId, userId)
            )
          ) || canCompanyManageUsers(companyId);
        allow update: if canCompanyManageUsers(companyId)
          || (isOwner(userId)
            && request.resource.data.role == resource.data.role);
        allow delete: if false;
      }

      match /invitations/{inviteId} {
        allow list: if canCompanyManageUsers(companyId);
        allow get: if canCompanyManageUsers(companyId)
          || (
            resource.data.status == 'pending'
            && invitationNotExpired(resource.data)
          )
          || invitationBelongsToCurrentIdentity(resource.data);
        allow create: if canCompanyManageUsers(companyId);
        allow update: if canCompanyManageUsers(companyId)
          || (
            isSignedIn()
            && resource.data.status == 'pending'
            && invitationNotExpired(resource.data)
            && request.resource.data.status in ['accepted', 'revoked']
            && request.resource.data.companyId == resource.data.companyId
            && request.resource.data.inviteToken == resource.data.inviteToken
            && request.resource.data.role == resource.data.role
            && request.resource.data.emailLower == resource.data.emailLower
            && request.resource.data.email == resource.data.email
            && request.resource.data.invitedBy == resource.data.invitedBy
            && invitationBelongsToCurrentIdentity(resource.data)
          );
        allow delete: if false;
      }

      match /products/{productId} {
        allow read: if canCompanyRead(companyId);
        allow create: if canCompanyManageCatalog(companyId);
        allow update: if (canCompanyManageCatalog(companyId) && !touchesDeleteFields())
          || normalizedRole(companyRole(companyId)) == 'admin';
        allow delete: if false;
      }

      match /locations/{locationId} {
        allow read: if canCompanyRead(companyId);
        allow create, update: if canCompanyManageCatalog(companyId);
        allow delete: if normalizedRole(companyRole(companyId)) == 'admin';
      }

      match /location_types/{typeId} {
        allow read: if canCompanyRead(companyId);
        allow create, update: if canCompanyManageCatalog(companyId);
        allow delete: if normalizedRole(companyRole(companyId)) == 'admin';
      }

      match /alerts/{alertId} {
        allow read: if canCompanyRead(companyId);
        allow create, update: if canCompanyManageInventory(companyId);
        allow delete: if false;
      }

      match /stock_movements/{movementId} {
        allow read: if canCompanyRead(companyId);
        allow create, update: if canCompanyManageInventory(companyId);
        allow delete: if false;
      }

      match /stock_requests/{requestId} {
        allow read: if canCompanyRead(companyId);
        allow create, update: if canCompanyManageInventory(companyId);
        allow delete: if false;
      }

      match /activity_logs/{logId} {
        allow read: if canCompanyRead(companyId);
        allow create: if canCompanyManageInventory(companyId);
        allow update, delete: if false;
      }

      match /company_profile/{docId} {
        allow read: if canCompanyRead(companyId);
        allow create: if canCompanyManageProfile(companyId)
          || isCompanyBootstrapOwner(companyId, request.auth.uid);
        allow update: if canCompanyManageProfile(companyId);
        allow delete: if false;
      }
    }
  }
}

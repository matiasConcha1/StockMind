{
  "name": "stockmind-functions",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "build": "tsc",
    "clean": "powershell -Command \"if (Test-Path lib) { Remove-Item -Recurse -Force lib }\"",
    "gcp-build": "npm run build",
    "lint": "tsc --noEmit",
    "deploy": "firebase deploy --only functions",
    "serve": "npm run build && firebase emulators:start --only functions"
  },
  "dependencies": {
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^6.3.2"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
